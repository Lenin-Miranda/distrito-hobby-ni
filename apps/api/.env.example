PORT=4000
WEB_ORIGINS=http://localhost:3000
# Default is false. Set true only with valid PostgreSQL runtime credentials.
# pnpm dev:local injects true plus generated local URLs; no copying needed.
# DATABASE_ENABLED=false
DATABASE_URL=
# Prisma tooling only; never passed to the API container or web.
DIRECT_URL=
SHADOW_DATABASE_URL=
# Future integrations remain uninitialized.
BETTER_AUTH_SECRET=
CLOUDINARY_URL=
RESEND_API_KEY=
PAYMENT_PROVIDER=

# Documentation template only. pnpm local:setup creates .local/<profile>/compose.env
# without overwriting existing files. Do not put migration/bootstrap secrets here.
# Process > .env.docker.local > .env.docker; conflicting managed values stop setup.
LOCAL_PROJECT=distrito-hobby-ni-apps
LOCAL_NETWORK=distrito-hobby-ni-local
WEB_PORT=3000
API_PORT=4000
WEB_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Supplied automatically with the generated restricted runtime password:
LOCAL_DATABASE_URL=
